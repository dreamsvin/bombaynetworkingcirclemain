# Public site URL (no trailing slash). Used for canonical URLs, sitemap, OG and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.bombaynetworkingcircle.com

# Supabase. Without these the site renders from content/seed.ts (typed, same shapes as the DB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used by server actions for inserts.
SUPABASE_SERVICE_ROLE_KEY=

# Placeholder content (rows marked [PLACEHOLDER — replace before launch]) renders only when this is "true".
# Leave unset/false in production. Set "true" on Preview deployments to review layouts.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false

# Optional: shared rate limiting across serverless instances (falls back to in-memory).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: secret for POST /api/revalidate (on-demand ISR after editing Supabase rows).
REVALIDATE_SECRET=

# Optional: double opt-in emails for the newsletter (Resend). Without them subscribers stay unconfirmed.
RESEND_API_KEY=
MAIL_FROM="Bombay Networking Circle <events@bombaynetworkingcircle.com>"

# Google Sheets backend (form submissions → the "BNC – Access Requests" sheet). See scripts/google-sheets-webhook.gs.
# With these set, Request access, newsletter and contact forms work even without Supabase.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=
